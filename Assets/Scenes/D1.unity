--- !u!114 &5061774655581283326
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7962405049294638772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d03ef50e4be42f29f9a457f5cce1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  steps:
  - title: Welcome
    instruction: Welcome to Ping Pong Trick Shots. Everything you need is in the
      cupboard in front of you.
    reminderText: 
    voiceover: {fileID: 8300000, guid: f3466c46f76005b48a9e8ba7341d3811, type: 3}
    reminder: {fileID: 0}
    completeWhen: 0
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Ball container
    instruction: Grab the ball container from the middle shelf. Squeeze the grip
      to pick it up.
    reminderText: Reach for the ball container and squeeze the grip.
    voiceover: {fileID: 0}
    reminder: {fileID: 8300000, guid: d498f3788b4fd484fade4da62b70d730, type: 3}
    completeWhen: 1
    waitSeconds: 2
    highlight: {fileID: 6426647750051772782}
  - title: Spawn a ball
    instruction: Now press A on your right hand to spawn a ball.
    reminderText: Press A to spawn a ball.
    voiceover: {fileID: 8300000, guid: a33a61b4500c3e64da5e0cac4e531945, type: 3}
    reminder: {fileID: 8300000, guid: d3cf6fc6c5d41144299f846f8fd4da12, type: 3}
    completeWhen: 2
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Trick shot
    instruction: Grab the ball and throw it into a cup. You can take a cup from the
      cupboard and put it anywhere.
    reminderText: Throw a ball into a cup. Gently does it.
    voiceover: {fileID: 8300000, guid: 47ecb4554180bbe44aca6c33cf63f977, type: 3}
    reminder: {fileID: 8300000, guid: 3027e98039d80484886380bcf2f9ce79, type: 3}
    completeWhen: 3
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Endless props
    instruction: Take anything you like from the cupboard. Don't worry, it refills
      itself.
    reminderText: Grab a prop from the cupboard and watch the shelf refill.
    voiceover: {fileID: 8300000, guid: 0e249e1e23b7348469a4abcb68309c40, type: 3}
    reminder: {fileID: 8300000, guid: c99867a49669e06489b88a7c12fb36b9, type: 3}
    completeWhen: 4
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Resize
    instruction: Hold a prop and press the trackpad firmly. Move your hand up to
      grow it, down to shrink it.
    reminderText: Hold a prop, press the trackpad, and move your hand up or down.
    voiceover: {fileID: 8300000, guid: c34d570dff1431940883ac43bad0960b, type: 3}
    reminder: {fileID: 8300000, guid: 81e6a48c6322921459cea5ac951180fe, type: 3}
    completeWhen: 5
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Delete
    instruction: Made a mess? Hold B and point the laser at a prop to delete it.
    reminderText: Hold B and point at a prop.
    voiceover: {fileID: 8300000, guid: 8b0aa7b3779c60948b2114879d53d8d8, type: 3}
    reminder: {fileID: 8300000, guid: 8db75b376a5f2c749bcf1339d83f64e6, type: 3}
    completeWhen: 6
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Free play
    instruction: That's it. Build your best trick shot.
    reminderText: 
    voiceover: {fileID: 8300000, guid: 38f3946690598cf4cac9c54232b8ef95, type: 3}
    reminder: {fileID: 0}
    completeWhen: 0
    waitSeconds: 3
    highlight: {fileID: 0}
  playOnStart: 1
  pauseBetweenSteps: 0.75
  resizeThreshold: 0.15
  voiceSource: {fileID: 0}
  musicSource: {fileID: 0}
  musicPlayer: {fileID: 94272885}
  musicDuckFactor: 0.35
  reminderDelay: 15
  reminderRepeat: 20
  textOverride: {fileID: 0}
  wallAnchor: {fileID: 8593598414891144012}
  panelDistance: 1.2
  panelHeightOffset: -0.25
  panelWidth: 1.3
  panelHeight: 0.45
  textHeight: 0.065
  panelColor: {r: 0.05, g: 0.06, b: 0.09, a: 0.82}
  titleColor: {r: 1, g: 0.62, b: 0.25, a: 1}
  holdToSkipStep: 1.5
  holdToSkipAll: 4
  leftClickBinding: <XRController>{LeftHand}/{Primary2DAxisClick}
  rightClickBinding: <XRController>{RightHand}/{Primary2DAxisClick}
  hapticAmplitude: 0.5
  hapticDuration: 0.15
  TutorialFinished:
    m_PersistentCalls:
      m_Calls: []
