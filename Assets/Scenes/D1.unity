--- !u!114 &5061774655581283326
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7962405049294638772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d03ef50e4be42f29f9a457f5cce1c6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  steps:
  - title: Welcome
    instruction: Welcome to Ping Pong Trick Shots. Everything you need is in the
      cupboard in front of you.
    reminderText: 
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 0
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Ball container
    instruction: Grab the ball container from the middle shelf. Squeeze the grip
      to pick it up.
    reminderText: Reach for the ball container and squeeze the grip.
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 1
    waitSeconds: 2
    highlight: {fileID: 6426647750051772782}
  - title: Spawn a ball
    instruction: Now press A on your right hand to spawn a ball.
    reminderText: Press A to spawn a ball.
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 2
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Trick shot
    instruction: Grab the ball and throw it into a cup. You can take a cup from the
      cupboard and put it anywhere.
    reminderText: Throw a ball into a cup. Gently does it.
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 3
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Endless props
    instruction: Take anything you like from the cupboard. Don't worry, it refills
      itself.
    reminderText: Grab a prop from the cupboard and watch the shelf refill.
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 4
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Resize
    instruction: Hold a prop and press the trackpad firmly. Move your hand up to
      grow it, down to shrink it.
    reminderText: Hold a prop, press the trackpad, and move your hand up or down.
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 5
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Delete
    instruction: Made a mess? Hold B and point the laser at a prop to delete it.
    reminderText: Hold B and point at a prop.
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 6
    waitSeconds: 2
    highlight: {fileID: 0}
  - title: Free play
    instruction: That's it. Build your best trick shot.
    reminderText: 
    voiceover: {fileID: 0}
    reminder: {fileID: 0}
    completeWhen: 0
    waitSeconds: 3
    highlight: {fileID: 0}
  playOnStart: 1
  pauseBetweenSteps: 0.75
  resizeThreshold: 0.15
  voiceSource: {fileID: 0}
  musicSource: {fileID: 94272884}
  musicDuckFactor: 0.35
  reminderDelay: 15
  reminderRepeat: 20
  textOverride: {fileID: 0}
  wallAnchor: {fileID: 8593598414891144012}
  panelDistance: 1.2
  panelHeightOffset: -0.25
  panelWidth: 1.3
  panelHeight: 0.45
  textHeight: 0.065
  panelColor: {r: 0.05, g: 0.06, b: 0.09, a: 0.82}
  titleColor: {r: 1, g: 0.62, b: 0.25, a: 1}
  holdToSkipStep: 1.5
  holdToSkipAll: 4
  leftClickBinding: <XRController>{LeftHand}/{Primary2DAxisClick}
  rightClickBinding: <XRController>{RightHand}/{Primary2DAxisClick}
  hapticAmplitude: 0.5
  hapticDuration: 0.15
